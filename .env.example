PORT=8787
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite): use wss:// when the page is served over HTTPS.
VITE_SIGNAL_URL=ws://localhost:8787
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN. Comma-separated URLs are accepted.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional TLS for the signaling server (required for wss:// on a LAN/internet).
TLS_CERT_PATH=
TLS_KEY_PATH=

# General password required before the room lobby is shown.
ROOM_PASSWORD=coloque-a-senha-geral-do-site-aqui
# Used to sign site and room sessions. Generate a long random value online.
SESSION_SECRET=change-this-to-a-different-long-random-secret
ADMIN_PASSWORD_1=
ADMIN_PASSWORD_2=
ADMIN_PASSWORD_3=
ADMIN_PASSWORD_4=

# Optional TLS for Vite development server.
VITE_HTTPS_CERT_PATH=
VITE_HTTPS_KEY_PATH=

PORT=8787
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite): use wss:// when the page is served over HTTPS.
VITE_SIGNAL_URL=ws://localhost:8787
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional fixed TURN for local development only. Comma-separated URLs are accepted.
# Do not put permanent production credentials in VITE_* variables.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Cloudflare Realtime TURN (production). These secrets stay only on the backend.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional TLS for the signaling server (required for wss:// on a LAN/internet).
TLS_CERT_PATH=
TLS_KEY_PATH=

# Used to sign site and room sessions. Generate a long random value online.
SESSION_SECRET=change-this-to-a-different-long-random-secret
# ADMIN_PASSWORD_1 is the only SUPER ADM and can enter every room.
# ADMIN_PASSWORD_2 through 4 are regular admins and still need each room password.
ADMIN_PASSWORD_1=
ADMIN_PASSWORD_2=
ADMIN_PASSWORD_3=
ADMIN_PASSWORD_4=

# Optional TLS for Vite development server.
VITE_HTTPS_CERT_PATH=
VITE_HTTPS_KEY_PATH=

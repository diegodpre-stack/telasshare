PORT=8787
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite): use wss:// when the page is served over HTTPS.
VITE_SIGNAL_URL=ws://localhost:8787
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional fixed TURN for local development only. Comma-separated URLs are accepted.
# Do not put permanent production credentials in VITE_* variables.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Cloudflare Realtime TURN (production). These secrets stay only on the backend.
# Nothing here is optional together: without TURN_ENABLED the relay is never offered however good the
# keys are, and without the account and analytics pair the server cannot read how much has been spent,
# so it refuses to spend more. That refusal is deliberate -- it would rather leave people on P2P than
# run up a bill it cannot see -- but it looks exactly like a broken relay, so set all four or none.
TURN_ENABLED=false
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# The monthly ceiling, in gigabytes. Reaching it stops the relay being offered until the month turns.
TURN_MONTHLY_LIMIT_GB=800

# Optional TLS for the signaling server (required for wss:// on a LAN/internet).
TLS_CERT_PATH=
TLS_KEY_PATH=

# Where permanent rooms and their conversations are kept. A temporary room never touches it.
# MongoDB Atlas gives a connection string; pick the region closest to the server or every query pays
# for the distance. Without this the server still runs -- it just cannot offer permanent rooms.
MONGODB_URI=
MONGODB_DB=telasshare

# Where the files sent in permanent rooms are kept, one folder per room, removed with the room.
FILES_DIR=./arquivos
# The ceiling for one file, and for everything one room holds. Bytes.
MAX_FILE_BYTES=26214400
MAX_ROOM_BYTES=5368709120

# How long a permanent room may go unvisited before it is removed, and how long a co-owner's request to
# delete one waits before it takes effect. Anybody entering resets the first clock. Milliseconds.
ROOM_IDLE_MS=5184000000
ROOM_DELETE_DELAY_MS=259200000
# How long an address handed out for a file stays valid. Short on purpose: the address is the whole
# permission, so one copied out of a room works for anybody until it expires. The page renews the ones
# it is showing on its own, so this is not felt from inside the room. Milliseconds.
FILE_LINK_MS=21600000

# How often those two clocks are looked at. Only worth changing to make a test run in seconds.
ROOM_SWEEP_MS=3600000

# RENDER is set by Render itself, not here; the server only reads it to know where it is running.

# Used to sign site and room sessions. Generate a long random value online.
SESSION_SECRET=change-this-to-a-different-long-random-secret

# Optional TLS for Vite development server.
VITE_HTTPS_CERT_PATH=
VITE_HTTPS_KEY_PATH=
